/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(mcu_heap_free_bytes,
    QUANTA_META("mcu.heap.free_bytes", "Free heap"),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_mcu, "heap_free"),
    QUANTA_SOURCE("", "esp_get_free_heap_size"))

QUANTA_METRIC(mcu_heap_min_free_bytes,
    QUANTA_META("mcu.heap.min_free_bytes", "Minimum free heap since boot"),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_mcu, "heap_min_free"),
    QUANTA_SOURCE("", "esp_get_minimum_free_heap_size"))

QUANTA_METRIC(mcu_cpu_freq_mhz,
    QUANTA_META("mcu.cpu.freq_mhz", "CPU clock frequency"),
    QUANTA_GAUGE_U64("MHz", 1000),
    QUANTA_SNAPSHOT(quanta_mcu, "freq_mhz"),
    QUANTA_SOURCE("", "configCPU_CLOCK_HZ"))

QUANTA_METRIC(mcu_power_vdd_mv,
    QUANTA_META_VERSION("mcu.power.vdd_mv", "Supply voltage", "Supply voltage", 2),
    QUANTA_GAUGE_U64("mV", 1000),
    QUANTA_SNAPSHOT(quanta_mcu, "vdd_mv"),
    QUANTA_SOURCE("", "esp_wifi_get_vdd33"))

QUANTA_METRIC(mcu_cores,
    QUANTA_META("mcu.cores", "CPU core count"),
    QUANTA_VALUE(QUANTA_U64, QUANTA_PROPERTY, QUANTA_REFRESH_ONCE, ""),
    QUANTA_TIMING_MS(0, 0, 0),
    QUANTA_SNAPSHOT(quanta_mcu, "cores"),
    QUANTA_SOURCE("", "esp_chip_info"))

QUANTA_METRIC(mcu_revision,
    QUANTA_META("mcu.revision", "Chip wafer revision"),
    QUANTA_VALUE(QUANTA_U64, QUANTA_PROPERTY, QUANTA_REFRESH_ONCE, ""),
    QUANTA_TIMING_MS(0, 0, 0),
    QUANTA_SNAPSHOT(quanta_mcu, "revision"),
    QUANTA_SOURCE("", "esp_chip_info"))

QUANTA_METRIC(mcu_chip_id,
    QUANTA_META_VERSION("mcu.chip_id", "Chip ID", "Chip ID", 2),
    QUANTA_VALUE(QUANTA_U64, QUANTA_PROPERTY, QUANTA_REFRESH_ONCE, ""),
    QUANTA_TIMING_MS(0, 0, 0),
    QUANTA_SNAPSHOT(quanta_mcu, "chip_id"),
    .flags = QUANTA_SENSITIVE,
    QUANTA_SOURCE("", "esp_efuse_mac_get_default"))

QUANTA_METRIC(mcu_flash_embedded,
    QUANTA_META("mcu.flash_embedded", "Embedded flash present"),
    QUANTA_VALUE(QUANTA_BOOL, QUANTA_PROPERTY, QUANTA_REFRESH_ONCE, ""),
    QUANTA_TIMING_MS(0, 0, 0),
    QUANTA_SNAPSHOT(quanta_mcu, "flash_embedded"),
    QUANTA_SOURCE("", "esp_chip_info"))

QUANTA_METRIC(mcu_sdk_version,
    QUANTA_META("mcu.sdk_version", "SDK version"),
    QUANTA_VALUE(QUANTA_STRING, QUANTA_PROPERTY, QUANTA_REFRESH_ONCE, ""),
    QUANTA_TIMING_MS(0, 0, 0),
    QUANTA_SNAPSHOT(quanta_mcu, "sdk_version"),
    QUANTA_SOURCE("", "esp_get_idf_version"))
