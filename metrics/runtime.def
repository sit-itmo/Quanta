/**
 * @file metrics/runtime.def
 *
 * Quanta version and selected-HAL metric declarations: names, units, policies, sources and
 * callbacks.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(quanta_version,
    QUANTA_META("quanta.version", "Quanta version"),
    QUANTA_PROPERTY_TEXT(0),
    QUANTA_SINGLE_READ(quanta_runtime_read, "version"),
    QUANTA_SOURCE("", "build"))

QUANTA_METRIC(hal_name,
    QUANTA_META("hal.name", "Selected hardware backend"),
    QUANTA_PROPERTY_TEXT(0),
    QUANTA_SINGLE_READ(quanta_runtime_read, "hal_name"),
    QUANTA_SOURCE("", "HAL get_info"))

QUANTA_METRIC(hal_capabilities,
    QUANTA_META("hal.capabilities", "Implemented HAL operations bitmask"),
    QUANTA_PROPERTY_U64("", 0),
    QUANTA_SINGLE_READ(quanta_runtime_read, "capabilities"),
    QUANTA_SOURCE("", "HAL get_info"))

QUANTA_METRIC(hal_logical_cpus,
    QUANTA_META("hal.logical_cpus", "HAL logical CPU count"),
    QUANTA_PROPERTY_U64("count", 0),
    QUANTA_SINGLE_READ(quanta_runtime_read, "logical_cpus"),
    QUANTA_SOURCE("", "HAL get_info"))
