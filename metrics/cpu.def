/**
 * @file metrics/cpu.def
 *
 * CPU metric declarations: names, units, policies, sources and callbacks.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(cpu_utilization,
    QUANTA_META_DESC("cpu.utilization", "CPU busy fraction",
        "Delta busy / delta total; idle and iowait are not busy; guest is not counted twice."),
    QUANTA_GAUGE_RATIO(100),
    QUANTA_SNAPSHOT(quanta_cpu, "utilization"),
    QUANTA_SOURCE("", ""))

QUANTA_METRIC(cpu_time_total,
    QUANTA_META("cpu.time_total", "CPU accounted ticks"),
    QUANTA_COUNTER_U64("ticks", 100),
    QUANTA_SNAPSHOT(quanta_cpu, "total"),
    QUANTA_SOURCE("", ""))

QUANTA_METRIC(cpu_idle_total,
    QUANTA_META("cpu.idle_total", "CPU idle ticks"),
    QUANTA_COUNTER_U64("ticks", 100),
    QUANTA_SNAPSHOT(quanta_cpu, "idle"),
    QUANTA_SOURCE("", ""))

QUANTA_METRIC(cpu_core_utilization,
    QUANTA_META_DESC("cpu.core.utilization", "CPU busy fraction",
        "Delta busy / delta total; idle and iowait are not busy; guest is not counted twice."),
    QUANTA_GAUGE_RATIO(100),
    QUANTA_SNAPSHOT(quanta_cpu, "utilization"),
    QUANTA_SOURCE("cpu", ""))

QUANTA_METRIC(cpu_core_time_total,
    QUANTA_META("cpu.core.time_total", "CPU accounted ticks"),
    QUANTA_COUNTER_U64("ticks", 100),
    QUANTA_SNAPSHOT(quanta_cpu, "total"),
    QUANTA_SOURCE("cpu", ""))

QUANTA_METRIC(cpu_core_idle_total,
    QUANTA_META("cpu.core.idle_total", "CPU idle ticks"),
    QUANTA_COUNTER_U64("ticks", 100),
    QUANTA_SNAPSHOT(quanta_cpu, "idle"),
    QUANTA_SOURCE("cpu", ""))
