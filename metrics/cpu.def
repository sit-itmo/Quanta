INV_METRIC(cpu_utilization,
 .key="cpu.utilization", .title="CPU busy fraction",
 .description="Delta busy / delta total; idle and iowait are not busy; guest is not counted twice.", .doc_path="docs/metrics/cpu.utilization.md",
 .semantic_version=1, .type=INV_F64, .kind=INV_GAUGE, .refresh=INV_REFRESH_POLL,
 .unit="1", .min_poll_ns=UINT64_C(100000000),
 .recommended_poll_ns=INV_NS_S, .stale_after_ns=UINT64_C(5000000000),
 .flags=0, .counter_bits=0,
 .label_schema="", .dependencies="",
 .provider=&inv_cpu_provider, .read=inv_cpu_read, .arg="utilization"
)
