/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(os_memory_total_bytes,
    QUANTA_META("os.memory.total_bytes", "Physical memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "total"),
    QUANTA_SOURCE("", "/proc/meminfo"))

QUANTA_METRIC(os_memory_available_bytes,
    QUANTA_META("os.memory.available_bytes", "Available memory estimate"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "available"),
    QUANTA_SOURCE("", "/proc/meminfo"))

QUANTA_METRIC(os_memory_free_bytes,
    QUANTA_META("os.memory.free_bytes", "Completely free memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "free"),
    QUANTA_SOURCE("", "/proc/meminfo"))

QUANTA_METRIC(os_memory_used_bytes,
    QUANTA_META("os.memory.used_bytes", "Memory: total minus available"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "used"),
    QUANTA_SOURCE("", "/proc/meminfo"))

QUANTA_METRIC(os_memory_utilization,
    QUANTA_META("os.memory.utilization", "Memory utilization"),
    QUANTA_GAUGE_RATIO(250),
    QUANTA_SNAPSHOT(quanta_memory, "utilization"),
    QUANTA_SOURCE("", "MemTotal,MemAvailable"))

QUANTA_METRIC(os_swap_total_bytes,
    QUANTA_META("os.swap.total_bytes", "Swap capacity"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "swap_total"),
    QUANTA_SOURCE("", ""))

QUANTA_METRIC(os_swap_used_bytes,
    QUANTA_META("os.swap.used_bytes", "Used swap"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "swap_used"),
    QUANTA_SOURCE("", ""))
