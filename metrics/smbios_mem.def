/**
 * @file metrics/smbios_mem.def
 *
 * HAL physical-memory SMBIOS metric declarations: names, units, policies, sources and callbacks.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(smbios_mem_board,
    QUANTA_META("smbios.legacy_mem.board.model", "Board model via legacy physical SMBIOS"),
    QUANTA_PROPERTY_TEXT(0),
    QUANTA_SNAPSHOT(quanta_smbios_mem, "board_model"),
    .flags = QUANTA_EXPENSIVE,
    QUANTA_SOURCE("", "HAL read_mem; legacy firmware window"))

QUANTA_METRIC(smbios_mem_bios,
    QUANTA_META("smbios.legacy_mem.bios.vendor", "BIOS vendor via legacy physical SMBIOS"),
    QUANTA_PROPERTY_TEXT(0),
    QUANTA_SNAPSHOT(quanta_smbios_mem, "bios_vendor"),
    .flags = QUANTA_EXPENSIVE,
    QUANTA_SOURCE("", "HAL read_mem; legacy firmware window"))
