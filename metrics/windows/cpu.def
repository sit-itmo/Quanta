QUANTA_METRIC(cpu_utilization,
 .key="cpu.utilization", .title="CPU busy fraction",
 .description="Windows CPU accounting. Aggregate raw ticks use 100 ns units and are unsupported on multi-group systems; utilization supports processor groups.", .doc_path="docs/metrics/cpu.utilization.md",
 .semantic_version=1, .type=QUANTA_F64, .kind=QUANTA_GAUGE, .refresh=QUANTA_REFRESH_POLL,
 .unit="1", .min_poll_ns=UINT64_C(100000000),
 .recommended_poll_ns=QUANTA_NS_S, .stale_after_ns=UINT64_C(5000000000),
 .flags=0, .counter_bits=0,
 .label_schema="", .dependencies="GetSystemTimes / PDH Processor Information",
 .init=quanta_cpu_init,
    .enumerate=quanta_cpu_enumerate,
    .collect=quanta_cpu_collect,
    .destroy=quanta_cpu_destroy,
    .read=quanta_cpu_read, .arg="utilization"
)
