/**
 * @file metrics/windows/memory.def
 *
 * Windows memory metric declarations: names, units, policies, sources and callbacks.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(os_memory_total_bytes,
    QUANTA_META("os.memory.total_bytes", "Physical memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "total"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(os_memory_available_bytes,
    QUANTA_META("os.memory.available_bytes", "Available memory estimate"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "available"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(os_memory_used_bytes,
    QUANTA_META("os.memory.used_bytes", "Memory: total minus available"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "used"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(os_memory_utilization,
    QUANTA_META("os.memory.utilization", "Memory utilization"),
    QUANTA_GAUGE_RATIO(250),
    QUANTA_SNAPSHOT(quanta_memory, "utilization"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_commit_used_bytes,
    QUANTA_META("windows.memory.commit.used_bytes", "System committed memory, not pagefile occupancy"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "commit_used"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_commit_limit_bytes,
    QUANTA_META("windows.memory.commit.limit_bytes", "System commit limit"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "commit_limit"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_commit_peak_bytes,
    QUANTA_META("windows.memory.commit.peak_bytes", "Peak system commit since boot"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "commit_peak"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_cache_bytes,
    QUANTA_META("windows.memory.cache_bytes", "System cache physical pages"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "cache"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_kernel_paged_bytes,
    QUANTA_META("windows.memory.kernel_paged_bytes", "Paged kernel memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "kernel_paged"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_memory_kernel_nonpaged_bytes,
    QUANTA_META("windows.memory.kernel_nonpaged_bytes", "Nonpaged kernel memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_memory, "kernel_nonpaged"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_os_process_count,
    QUANTA_META("os.process.count", "System process count"),
    QUANTA_GAUGE_U64("", 250),
    QUANTA_SNAPSHOT(quanta_memory, "process_count"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_os_thread_count,
    QUANTA_META("os.thread.count", "System thread count"),
    QUANTA_GAUGE_U64("", 250),
    QUANTA_SNAPSHOT(quanta_memory, "thread_count"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))

QUANTA_METRIC(win_windows_handle_count,
    QUANTA_META("windows.handle.count", "System handle count"),
    QUANTA_GAUGE_U64("", 250),
    QUANTA_SNAPSHOT(quanta_memory, "handle_count"),
    QUANTA_SOURCE("", "GlobalMemoryStatusEx / GetPerformanceInfo"))
