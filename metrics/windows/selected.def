/**
 * @file metrics/windows/selected.def
 *
 * Select .def groups for the current configuration through conditional inclusion; no runtime
 * logic.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
#include "windows/os.def"
#if QUANTA_WITH_MEMORY
#include "windows/memory.def"
#endif
#if QUANTA_WITH_CPU
#include "windows/cpu.def"
#endif
#if QUANTA_WITH_CPUID && QUANTA_ARCH_X86
#include "windows/cpuid.def"
#endif
#if QUANTA_WITH_DMI
#include "windows/dmi.def"
#endif
#if QUANTA_WITH_NETWORK
#include "windows/network.def"
#endif
#if QUANTA_WITH_HWMON
#include "windows/hwmon.def"
#endif
#if QUANTA_WITH_FILESYSTEM
#include "windows/filesystem.def"
#endif
#if QUANTA_WITH_PROCESS
#include "windows/process.def"
#endif
