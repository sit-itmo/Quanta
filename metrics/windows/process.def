/**
 * @file metrics/windows/process.def
 *
 * Windows current-process metric declarations: names, units, policies, sources and callbacks.
 *
 * Metric: a measurement descriptor with a stable name, type, unit and callbacks. The descriptor
 * itself is not a measured value.
 *
 * A .def file is a declaration list included repeatedly through macros. It is compile-time
 * source, not runtime configuration or a separate provider.
 */
/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(process_self_rss_bytes,
    QUANTA_META("process.self.rss_bytes", "Collector resident memory"),
    QUANTA_GAUGE_BYTES(250),
    QUANTA_SNAPSHOT(quanta_process, "rss"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))

QUANTA_METRIC(win_process_self_pid,
    QUANTA_META("process.self.pid", "INV process ID"),
    QUANTA_PROPERTY_U64("", 5000),
    QUANTA_SNAPSHOT(quanta_process, "pid"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))

QUANTA_METRIC(win_process_self_private_bytes,
    QUANTA_META("process.self.private_bytes", "INV private committed memory"),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_process, "private"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))

QUANTA_METRIC(win_process_self_handles,
    QUANTA_META("process.self.handles", "INV handle count"),
    QUANTA_GAUGE_U64("", 1000),
    QUANTA_SNAPSHOT(quanta_process, "handles"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))

QUANTA_METRIC(win_process_self_io_read_bytes_total,
    QUANTA_META("process.self.io.read_bytes_total", "INV read transfer bytes (not necessarily disk I/O)"),
    QUANTA_COUNTER_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_process, "read_bytes"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))

QUANTA_METRIC(win_process_self_io_write_bytes_total,
    QUANTA_META("process.self.io.write_bytes_total", "INV write transfer bytes (not necessarily disk I/O)"),
    QUANTA_COUNTER_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_process, "write_bytes"),
    QUANTA_SOURCE("", "GetProcessMemoryInfo / GetProcessIoCounters"))
