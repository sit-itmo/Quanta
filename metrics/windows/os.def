/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(os_name,
    QUANTA_META("os.name", "Operating system"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_os, "name"),
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_kernel_release,
    QUANTA_META("os.kernel.release", "Kernel release"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_os, "release"),
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_kernel_version,
    QUANTA_META("os.kernel.version", "Kernel build"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_os, "version"),
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_arch,
    QUANTA_META("os.arch", "Machine architecture"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_os, "arch"),
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_hostname,
    QUANTA_META("os.hostname", "Host name"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_os, "hostname"),
    .flags = QUANTA_SENSITIVE,
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_uptime,
    QUANTA_META("os.uptime", "Time since boot"),
    QUANTA_GAUGE_SECONDS(1000),
    QUANTA_SNAPSHOT(quanta_os, "uptime"),
    QUANTA_SOURCE("", "Win32 system APIs"))

QUANTA_METRIC(os_cpu_online,
    QUANTA_META("os.cpu.online", "Online logical processors"),
    QUANTA_GAUGE_U64("", 1000),
    QUANTA_SNAPSHOT(quanta_os, "online"),
    QUANTA_SOURCE("", "Win32 system APIs"))
