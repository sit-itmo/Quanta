QUANTA_METRIC(fs_root_total_bytes,
 .key="fs.root.total_bytes", .title="Root filesystem capacity",
 .description="Windows installation volume in the caller quota view: used = total - available.", .doc_path="docs/metrics/fs.root.total_bytes.md",
 .semantic_version=1, .type=QUANTA_U64, .kind=QUANTA_GAUGE, .refresh=QUANTA_REFRESH_POLL,
 .unit="B", .min_poll_ns=UINT64_C(1000000000),
 .recommended_poll_ns=QUANTA_NS_S, .stale_after_ns=UINT64_C(5000000000),
 .flags=0, .counter_bits=0,
 .label_schema="", .dependencies="GetDiskFreeSpaceExW / Windows system volume",
 .init=quanta_filesystem_init,
    .enumerate=quanta_filesystem_enumerate,
    .collect=quanta_filesystem_collect,
    .destroy=quanta_filesystem_destroy,
    .read=quanta_filesystem_read, .arg="total_bytes"
)
