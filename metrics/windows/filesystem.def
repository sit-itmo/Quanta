/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(fs_root_total_bytes,
    QUANTA_META_DESC("fs.root.total_bytes", "Root filesystem capacity",
        "Windows installation volume in the caller quota view: used = total - available."),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_filesystem, "total_bytes"),
    QUANTA_SOURCE("", "GetDiskFreeSpaceExW / Windows system volume"))

QUANTA_METRIC(fs_root_available_bytes,
    QUANTA_META_DESC("fs.root.available_bytes", "Root filesystem space available to this user",
        "Windows installation volume in the caller quota view: used = total - available."),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_filesystem, "available_bytes"),
    QUANTA_SOURCE("", "GetDiskFreeSpaceExW / Windows system volume"))

QUANTA_METRIC(fs_root_used_bytes,
    QUANTA_META_DESC("fs.root.used_bytes", "Root filesystem allocated space",
        "Windows installation volume in the caller quota view: used = total - available."),
    QUANTA_GAUGE_BYTES(1000),
    QUANTA_SNAPSHOT(quanta_filesystem, "used_bytes"),
    QUANTA_SOURCE("", "GetDiskFreeSpaceExW / Windows system volume"))

QUANTA_METRIC(fs_root_utilization,
    QUANTA_META_DESC("fs.root.utilization", "Root filesystem allocated fraction",
        "Windows installation volume in the caller quota view: used = total - available."),
    QUANTA_GAUGE_RATIO(1000),
    QUANTA_SNAPSHOT(quanta_filesystem, "utilization"),
    QUANTA_SOURCE("", "GetDiskFreeSpaceExW / Windows system volume"))
