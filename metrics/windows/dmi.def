/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(board_vendor,
    QUANTA_META("board.vendor", "Board manufacturer"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_dmi, "board_vendor"),
    QUANTA_SOURCE("", "GetSystemFirmwareTable RSMB / bounded SMBIOS parser"))

QUANTA_METRIC(board_model,
    QUANTA_META("board.model", "Board model"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_dmi, "board_name"),
    QUANTA_SOURCE("", "GetSystemFirmwareTable RSMB / bounded SMBIOS parser"))

QUANTA_METRIC(board_serial,
    QUANTA_META("board.serial", "Board serial number"),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_SNAPSHOT(quanta_dmi, "board_serial"),
    .flags = QUANTA_SENSITIVE,
    QUANTA_SOURCE("", "GetSystemFirmwareTable RSMB / bounded SMBIOS parser"))

