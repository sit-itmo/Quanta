/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(device_net_mac,
    QUANTA_META("device.net.mac", "Link-layer address"),
    QUANTA_VALUE(QUANTA_STRING, QUANTA_PROPERTY, QUANTA_REFRESH_ON_EVENT, ""),
    QUANTA_TIMING_MS(250, 1000, 5000),
    QUANTA_SNAPSHOT(quanta_network, "address"),
    .flags = QUANTA_SENSITIVE,
    QUANTA_SOURCE("ifname,ifindex", ""))

QUANTA_METRIC(device_net_state,
    QUANTA_META("device.net.state", "Operational state"),
    QUANTA_VALUE(QUANTA_STRING, QUANTA_GAUGE, QUANTA_REFRESH_POLL, ""),
    QUANTA_TIMING_MS(250, 1000, 5000),
    QUANTA_SNAPSHOT(quanta_network, "operstate"),
    QUANTA_SOURCE("ifname,ifindex", ""))

QUANTA_METRIC(device_net_rx_bytes_total,
    QUANTA_META("device.net.rx_bytes_total", "Received bytes"),
    QUANTA_COUNTER_BYTES(100),
    QUANTA_SNAPSHOT(quanta_network, "rx_bytes"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))

QUANTA_METRIC(device_net_tx_bytes_total,
    QUANTA_META("device.net.tx_bytes_total", "Transmitted bytes"),
    QUANTA_COUNTER_BYTES(100),
    QUANTA_SNAPSHOT(quanta_network, "tx_bytes"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))

QUANTA_METRIC(device_net_rx_packets_total,
    QUANTA_META("device.net.rx_packets_total", "Received packets"),
    QUANTA_COUNTER_U64("packets", 100),
    QUANTA_SNAPSHOT(quanta_network, "rx_packets"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))

QUANTA_METRIC(device_net_tx_packets_total,
    QUANTA_META("device.net.tx_packets_total", "Transmitted packets"),
    QUANTA_COUNTER_U64("packets", 100),
    QUANTA_SNAPSHOT(quanta_network, "tx_packets"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))

QUANTA_METRIC(device_net_rx_errors_total,
    QUANTA_META("device.net.rx_errors_total", "Receive errors"),
    QUANTA_COUNTER_U64("errors", 100),
    QUANTA_SNAPSHOT(quanta_network, "rx_errors"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))

QUANTA_METRIC(device_net_tx_errors_total,
    QUANTA_META("device.net.tx_errors_total", "Transmit errors"),
    QUANTA_COUNTER_U64("errors", 100),
    QUANTA_SNAPSHOT(quanta_network, "tx_errors"),
    QUANTA_SOURCE("ifname,ifindex", "/proc/net/dev"))
