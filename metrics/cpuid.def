/* SPDX-License-Identifier: MIT -- intentionally no include guard.
 * Helpers: include/quanta/metric_def.h; each block is one implementation. */
QUANTA_METRIC(cpu_vendor,
    QUANTA_META_DESC("cpu.vendor", "CPU vendor",
        "CPU vendor; sampled on the explicitly pinned reference CPU, not an all-core intersection."),
    QUANTA_PROPERTY_TEXT(5000),
    QUANTA_INIT_SNAPSHOT(quanta_cpuid, "vendor"),
    QUANTA_SOURCE("", ""))

