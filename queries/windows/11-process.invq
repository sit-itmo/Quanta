version 1;
mode file;
format table;
every 1s;
count 5;
select process.self.pid;
select process.self.rss_bytes as value(unit="MiB");
select process.self.private_bytes as value(unit="MiB");
select process.self.handles;
select rate(process.self.io.read_bytes_total) as value(unit="KiB/s");
select rate(process.self.io.write_bytes_total) as value(unit="KiB/s");
