version 1;
mode gui;
every 1s;
history 10m;
layout grid(columns=3);
select cpu.utilization as gauge(min=0,max=1,title="CPU busy",unit="%");
select os.memory.utilization as bar(min=0,max=1,title="Physical memory",unit="%");
select windows.memory.commit.used_bytes as plot(unit="GiB",title="Committed memory");
select optional sensor.temperature as plot(unit="degC",title="Thermal zone") every 2s;
select optional rate(device.net.rx_bytes_total) as plot(unit="MiB/s",title="Receive");
select optional rate(device.net.tx_bytes_total) as plot(unit="MiB/s",title="Transmit");
select optional board.model as text(title="Baseboard");
select optional cpu.brand as text(title="Reference processor");
select os.process.count as value(title="Processes");
