version 1;
mode gui;
every 1s;
history 5m;
layout grid(columns=3);
select cpu.utilization as gauge(min=0, max=1, title="CPU busy");
select os.memory.utilization as bar(min=0, max=1, title="RAM");
select os.memory.available_bytes as value(unit="GiB", title="Available RAM");
select cpu.utilization as plot(min=0, max=1, title="CPU history");
select optional sensor.temperature as plot(title="Temperature") every 2s;
select optional rate(device.net.rx_bytes_total) as plot(unit="KiB/s", title="Receive");
select optional rate(device.net.tx_bytes_total) as plot(unit="KiB/s", title="Transmit");
select os.name as text(title="Operating system");
select optional board.model as text(title="Motherboard");
