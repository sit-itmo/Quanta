#include <windows.h>
1 RT_MANIFEST "inv.manifest"
1 VERSIONINFO
 FILEVERSION 0,2,2,0
 PRODUCTVERSION 0,2,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "INV System Inventory and Monitor\0"
      VALUE "FileVersion", "0.2.2\0"
      VALUE "ProductName", "INV\0"
      VALUE "ProductVersion", "0.2.2\0"
      VALUE "OriginalFilename", "inv.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
