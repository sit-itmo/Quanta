# Original lab hardware assumptions. Review against YOUR board before flashing.
CONFIG_ESP8266_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP8266_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP8266_XTAL_FREQ_26=y
CONFIG_ESP_PHY_INIT_DATA_VDD33_CONST=255
CONFIG_QUANTA_MEASURE_VDD33=y
