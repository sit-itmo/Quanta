# cmake/Frontends.cmake
# Validate frontend options and local dependencies; OPENGL by default, without fetching.
# Native builds include every frontend by default, failing on missing dependencies.
# Portable builds default to no native UI. AUTO remains an explicit opt-in fallback.
set(frontend_default ON)
if(QUANTA_PORTABLE)
    set(frontend_default OFF)
endif()
# AUTO includes every frontend whose compiler/platform dependencies are present.
# ON is a requirement (missing dependency is an error), OFF removes it completely.
set(QUANTA_WITH_GUI ${frontend_default} CACHE STRING "Dear ImGui frontend: AUTO, ON or OFF")
set(QUANTA_WITH_TUI ${frontend_default} CACHE STRING "Terminal frontend: AUTO, ON or OFF")
set_property(CACHE QUANTA_WITH_GUI QUANTA_WITH_TUI PROPERTY STRINGS AUTO ON OFF)
set(QUANTA_GUI_BACKEND "OPENGL" CACHE STRING "GUI backend: OPENGL (GLFW), FRAMEBUFFER (CPU)")
set_property(CACHE QUANTA_GUI_BACKEND PROPERTY STRINGS OPENGL FRAMEBUFFER)
string(TOUPPER "${QUANTA_GUI_BACKEND}" QUANTA_GUI_BACKEND)
if(NOT QUANTA_GUI_BACKEND MATCHES "^(OPENGL|FRAMEBUFFER)$")
    message(FATAL_ERROR "QUANTA_GUI_BACKEND must be OPENGL or FRAMEBUFFER")
endif()
set(QUANTA_GLFW_DIR "${PROJECT_SOURCE_DIR}/vendor/glfw" CACHE PATH "Windows: local GLFW source tree (3.4 bundled)")
set(QUANTA_IMGUI_DIR "${PROJECT_SOURCE_DIR}/vendor/imgui" CACHE PATH "Dear ImGui 1.92.9b source directory")
foreach(ui GUI TUI)
    string(TOUPPER "${QUANTA_WITH_${ui}}" request)
    if(NOT request MATCHES "^(AUTO|ON|OFF)$")
        message(FATAL_ERROR "QUANTA_WITH_${ui} must be AUTO, ON or OFF")
    endif()
    set(available ON)
    set(reason "")
    if(QUANTA_PORTABLE)
        set(available OFF)
        set(reason "portable profile has no native window/terminal backend")
    elseif(ui STREQUAL "GUI" AND NOT request STREQUAL "OFF")
        foreach(source imgui.cpp imgui_draw.cpp imgui_tables.cpp imgui_widgets.cpp imgui.h imconfig.h imgui_internal.h
                       imstb_rectpack.h imstb_textedit.h imstb_truetype.h)
            if(NOT EXISTS "${QUANTA_IMGUI_DIR}/${source}")
                set(available OFF)
                set(reason "Dear ImGui sources absent; see docs/BUILD.md")
            endif()
        endforeach()
        if(available)
            file(STRINGS "${QUANTA_IMGUI_DIR}/imgui.h" imgui_version_line REGEX "^#define +IMGUI_VERSION +")
            if(NOT imgui_version_line MATCHES "1\\.92\\.9b")
                set(available OFF)
                set(reason "this adapter targets Dear ImGui 1.92.9b; another version needs validation")
            endif()
        endif()
        if(available)
            include(CheckLanguage)
            check_language(CXX)
            if(NOT CMAKE_CXX_COMPILER)
                set(available OFF)
                set(reason "C++ compiler absent")
            endif()
        endif()
        if(available AND QUANTA_GUI_BACKEND STREQUAL "OPENGL")
            foreach(source imgui_impl_glfw.cpp imgui_impl_glfw.h imgui_impl_opengl3.cpp
                           imgui_impl_opengl3.h imgui_impl_opengl3_loader.h)
                if(NOT EXISTS "${QUANTA_IMGUI_DIR}/backends/${source}")
                    set(available OFF)
                    set(reason "ImGui GLFW/OpenGL backends absent in QUANTA_IMGUI_DIR")
                endif()
            endforeach()
            if(WIN32)
                foreach(source CMakeLists.txt include/GLFW/glfw3.h src/CMakeLists.txt
                               CMake/glfw3Config.cmake.in)
                    if(NOT EXISTS "${QUANTA_GLFW_DIR}/${source}")
                        set(available OFF)
                        set(reason "Incomplete local GLFW source tree: ${QUANTA_GLFW_DIR}/${source}. Restore vendor/glfw from the full archive; see vendor/GLFW.md. No automatic downloads.")
                    endif()
                endforeach()
            else()
                find_package(glfw3 3.3 QUIET CONFIG)
                if(NOT TARGET glfw)
                    set(available OFF)
                    set(reason "GLFW development package absent: sudo apt-get install libglfw3-dev")
                endif()
            endif()
            if(available)
                find_package(OpenGL QUIET)
            endif()
            if(available AND NOT OpenGL_FOUND)
                set(available OFF)
                set(reason "OpenGL development files absent; Ubuntu: apt-get install libgl-dev (normally pulled by libglfw3-dev)")
            endif()
            if(QUANTA_STRICT_STATIC AND NOT WIN32)
                set(available OFF)
                set(reason "system GLFW/OpenGL need shared graphics drivers; use linux-static-no-gui")
            endif()
        elseif(available AND NOT WIN32)
            find_package(X11 QUIET)
            if(NOT X11_FOUND)
                set(available OFF)
                set(reason "X11 development files absent: sudo apt-get install libx11-dev")
            endif()
        endif()
    endif()
    if(request STREQUAL "ON" AND NOT available)
        message(FATAL_ERROR "${ui} requested but unavailable: ${reason}")
    endif()
    if(request STREQUAL "OFF" OR NOT available)
        set(QUANTA_WITH_${ui} OFF)
    else()
        set(QUANTA_WITH_${ui} ON)
    endif()
    if(request STREQUAL "AUTO" AND NOT available)
        message(STATUS "${ui} AUTO: disabled (${reason})")
    endif()
endforeach()
